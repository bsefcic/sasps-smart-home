{
  "name": "sasps-smart-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comparative smart-home simulator for SASPS",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "node scripts/demo.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
